  "components": {
    "schemas": {
      "AddIngredients": {
        "properties": {
          "selections": {
            "items": {
              "$ref": "#/components/schemas/RecipeSelection"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Selections"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "selections",
          "expected_version"
        ],
        "title": "AddIngredients"
      },
      "Address": {
        "properties": {
          "building": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Building"
          },
          "tower": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Tower"
          },
          "floor": {
            "type": "string",
            "maxLength": 10,
            "minLength": 1,
            "title": "Floor"
          },
          "apartment": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Apartment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "building",
          "tower",
          "floor",
          "apartment"
        ],
        "title": "Address"
      },
      "AdvanceInput": {
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "next",
              "complete"
            ],
            "title": "Target",
            "default": "next"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AdvanceInput"
      },
      "AssistantInput": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Content"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content"
        ],
        "title": "AssistantInput"
      },
      "CartLine": {
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 99.0,
            "minimum": 0.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "CartLine"
      },
      "CartPatch": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartLine"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Items"
          },
          "mode": {
            "type": "string",
            "enum": [
              "set",
              "add"
            ],
            "title": "Mode",
            "default": "set"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "expected_version"
        ],
        "title": "CartPatch"
      },
      "DeliveryInput": {
        "properties": {
          "delivery_mode": {
            "type": "string",
            "enum": [
              "now",
              "scheduled"
            ],
            "title": "Delivery Mode"
          },
          "scheduled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduled At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "delivery_mode"
        ],
        "title": "DeliveryInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderInput": {
        "properties": {
          "quote_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Quote Id"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "contact": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Contact"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quote_id",
          "idempotency_key",
          "address",
          "contact"
        ],
        "title": "OrderInput"
      },
      "RecipeQuoteInput": {
        "properties": {
          "selections": {
            "items": {
              "$ref": "#/components/schemas/RecipeSelection"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Selections"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "selections"
        ],
        "title": "RecipeQuoteInput"
      },
      "RecipeSelection": {
        "properties": {
          "recipe_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Recipe Id"
          },
          "servings": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Servings",
            "default": 2
          },
          "ingredient_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Ingredient Ids"
          },
          "variant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recipe_id",
          "ingredient_ids"
        ],
        "title": "RecipeSelection"
      },
      "SessionInput": {
        "properties": {
          "renew": {
            "type": "boolean",
            "title": "Renew",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SessionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}